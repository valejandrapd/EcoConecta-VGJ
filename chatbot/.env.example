# Copia este archivo como .env (en la raíz del repo si usas Docker) y completa los valores. NUNCA subas el .env a GitHub.

# --- Obligatorias
WHAPI_TOKEN=
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=            # solo con Docker: contraseña de la base de datos

# --- Base de datos (sin Docker; con Docker la arma docker-compose.yml)
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/ecoconecta

# --- Audios (opcional; sin esto el bot pide texto o foto). Servicio de transcripción compatible con OpenAI (Groq u OpenAI)
# STT_API_KEY=
# STT_URL=https://api.groq.com/openai/v1/audio/transcriptions
# STT_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=es

# --- Piloto y reglas (opcionales)
# PILOTO_NUMEROS=573001112233,573004445566   # si se define, solo estos números pueden usar el bot (RN-08)
# PUNTOS_BASE=                               # regla de puntos de demostración, NO oficial (RN-06)
# PUNTOS_POR_KG=
# CLAUDE_MODEL=

# --- Backend real del equipo (opcional; si no se define se usa el backend provisional incluido)
# BACKEND_URL=https://TU-BACKEND/api/v1
# BACKEND_API_KEY=

# --- API REST para app/web (opcionales)
# API_KEY=
# CORS_ORIGINS=
# MAX_FOTO_MB=
# PORT=
