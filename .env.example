# Copia este archivo como .env y completa los valores. NUNCA subas el .env a GitHub.
# Los valores reales solo viajan por variables de entorno.

# --- Base de datos (PostgreSQL) ---
POSTGRES_PASSWORD=
# DATABASE_URL la arma docker-compose; fuera de Docker:
# DATABASE_URL=postgresql+psycopg://ecoconecta:<clave>@localhost:5432/ecoconecta

# --- WhatsApp Business Cloud API (Meta) ---
# whatsapp = envía por la Graph API | log = solo escribe en el log (sin credenciales)
NOTIFICADOR=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v21.0
# GRAPH_TIMEOUT_S=10
# WHATSAPP_PLANTILLA_IDIOMA=es
# PLANTILLA_SOLICITUD_RECIBIDA=solicitud_recibida
# PLANTILLA_NUEVA_SOLICITUD=nueva_solicitud
# PLANTILLA_SOLICITUD_PROGRAMADA=solicitud_programada

# --- IA (Claude API) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# IA_MODELO_TEXTO=
# IA_MODELO_VISION=
# IA_TIMEOUT_S=20

# --- Bot ---
# LIMITE_MENSAJES_DIA=50
# RETENCION_MENSAJES_DIAS=90
# ZONA_HORARIA=America/Bogota
# PAIS_TELEFONO=57
URL_FORMULARIO_SOLICITUD=http://localhost:3000/solicitudes/nueva
URL_REGISTRO=http://localhost:3000/registro
# Número del bot que verá la gente en el botón de WhatsApp de la web (con indicativo, sin +)
WHATSAPP_NUMERO_PUBLICO=

# --- Autenticación de la web ---
# Cadena aleatoria larga (mín. 16 caracteres) para firmar las sesiones
AUTH_SECRET=
# SESION_HORAS=12

# --- API interna (cabecera X-Service-Key) ---
SERVICE_API_KEY=

# --- Datos de demostración (python -m app.seed) ---
# DEMO_TELEFONO=
# DEMO_CLAVE=

# --- Reglas del piloto (RN-06 y RN-08) ---
# true = solo usuarios marcados como piloto pueden solicitar recolecciones
# MODO_PILOTO=true
# Puntos = base + kg x factor del flujo. Valores de EJEMPLO, sujetos a validación de FSD.
# PUNTOS_BASE_RECOLECCION=5
# PUNTOS_POR_KG_ORGANICO=2
# PUNTOS_POR_KG_RECICLABLE=3
