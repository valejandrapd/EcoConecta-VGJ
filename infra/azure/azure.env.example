# Configuración del despliegue en Azure.
# Uso: cp infra/azure/azure.env.example .env.azure  (en la raíz del repo; .env.* está en .gitignore)
# Las variables vacías marcadas "se genera" las crea el script la primera vez y las guarda aquí.
# Nunca subas este archivo al repositorio.

# --- Dónde ---
AZ_GRUPO=ecoconecta-rg
# Azure for Students solo permite: canadacentral, northcentralus, brazilsouth, chilecentral y francecentral
AZ_REGION=canadacentral
# Sufijo para nombres únicos en Azure (registro y base de datos). Se genera.
AZ_SUFIJO=

# --- Base de datos (Azure Database for PostgreSQL, servidor flexible) ---
PG_ADMIN=ecoadmin
# Se genera
PG_CLAVE=

# --- Aplicación ---
# Se genera (mín. 16 caracteres)
AUTH_SECRET=
SERVICE_API_KEY=
MODO_PILOTO=true
# 1 = carga zonas, personal y usuarios de demostración al arrancar (si faltan)
SEMBRAR_DEMO=1
# Clave de los usuarios demo en la nube. Se genera (no uses demo1234 en una URL pública)
DEMO_CLAVE=
# 0 = el backend se apaga sin tráfico (más barato, el primer mensaje tarda unos segundos)
# 1 = siempre encendido (recomendado durante la demo y con el webhook de WhatsApp)
MIN_REPLICAS=1

# --- IA (solo proveedores autorizados por el reto: Azure OpenAI / AI Foundry, OpenAI o Claude) ---
# azure_openai = Azure OpenAI pagado con el crédito de la suscripción (recomendado con Azure for Students)
# claude       = Claude API (requiere ANTHROPIC_API_KEY)
IA_PROVEEDOR=azure_openai
# 1 = el script crea el recurso de Azure OpenAI y el despliegue del modelo si no existen
CREAR_AZURE_OPENAI=1
# Región del recurso de IA. Debe estar permitida por la política de la suscripción y tener cuota.
# En Azure for Students, brazilsouth funciona con gpt-4.1-mini; las regiones fuera de la lista permitida están bloqueadas por política.
# Solo se permite un recurso S0 de OpenAI por región.
AZ_REGION_IA=brazilsouth
# Nombre del despliegue que usa el backend. Puede dejarse igual que el modelo.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Opcional: fuerza el modelo y la versión. Si se dejan vacíos, el script prueba gpt-4.1-mini y luego gpt-4o-mini.
# AZURE_OPENAI_MODELO=gpt-4.1-mini
# AZURE_OPENAI_MODELO_VERSION=2025-04-14
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Notas de voz de WhatsApp: 1 = el script despliega un modelo de transcripción (gpt-4o-mini-transcribe o whisper) si hay cuota
ACTIVAR_AUDIO=1
# Nombre del despliegue de transcripción. Lo guarda el script si logra crearlo
AZURE_OPENAI_STT_DEPLOYMENT=
# Si ya tienen un recurso de Azure OpenAI propio, pon estos dos y CREAR_AZURE_OPENAI=0
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# --- WhatsApp Business Cloud API (opcional: sin token el bot queda en modo log) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Número del bot para el botón de la web (con indicativo, sin +)
WHATSAPP_NUMERO_PUBLICO=
